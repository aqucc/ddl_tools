      "sourceText" : "CREATE PROCEDURE sales.cancel_order(IN p_order_id bigint) LANGUAGE plpgsql AS $$\nBEGIN\n  UPDATE sales.orders SET status = 'NEW' WHERE order_id = p_order_id;\nEND;\n$$"
