      } ],
      "returnType" : "numeric",
      "sourceText" : "CREATE OR REPLACE FUNCTION sales.order_total(p_customer_id bigint) RETURNS numeric AS $$\nDECLARE\n  v_total numeric;\nBEGIN\n  SELECT COALESCE(sum(amount), 0) INTO v_total FROM sales.orders WHERE customer_id = p_customer_id;\n  RETURN v_total;\nEND;\n$$ LANGUAGE plpgsql"
